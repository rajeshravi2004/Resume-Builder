# Client-side Supabase project values (safe public anon key; RLS is still required)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only OpenAI credential. Never prefix this with VITE_.
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5-mini

# Server-only Gemini credential. Never prefix this with VITE_.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Only needed when pushing Supabase Auth configuration from config.toml.
# These come from Google Auth Platform, not from Supabase.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=your-google-web-client-id
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=your-google-client-secret

# Local export server
PORT=4000
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
